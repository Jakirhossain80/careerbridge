PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Use a dedicated local/development database. Never commit a real connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/careerbridge_development

# Firebase Admin service-account fields (server-only).
# Keep the literal \n sequences when storing the private key on one line.
FIREBASE_PROJECT_ID=careerbridge-example
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@careerbridge-example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFAKE_EXAMPLE_KEY_DO_NOT_USE\n-----END PRIVATE KEY-----\n"

# Optional legacy configuration. Firebase ID tokens currently provide authentication.
JWT_SECRET=replace-with-a-random-development-only-placeholder
JWT_EXPIRES_IN=7d

# Required for résumé persistence and image-upload features.
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=example-api-key
CLOUDINARY_API_SECRET=example-api-secret
CLOUDINARY_UPLOAD_FOLDER=careerbridge-development

# HTTP request and upload policies.
JSON_BODY_LIMIT=1mb
AVATAR_UPLOAD_MAX_MB=5
COMPANY_LOGO_UPLOAD_MAX_MB=5
COMPANY_BANNER_UPLOAD_MAX_MB=8
RESUME_UPLOAD_MAX_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Keep 0 unless the deployment has exactly this many trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0
