# Browser-exposed values. Use a development Firebase project locally.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=fake-browser-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careerbridge-example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerbridge-example
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerbridge-example.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
